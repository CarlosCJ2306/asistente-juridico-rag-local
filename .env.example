APP_NAME=Asistente Jurídico RAG Local
APP_ENV=development
DEBUG=true

API_PREFIX=/api
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=DEBUG
LOG_TO_FILE=true
LOG_CONSOLE=true
LOG_DIR=storage/logs
LOG_FILE_NAME=asistente_juridico_backend.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

DATABASE_FILE=storage/database/asistente_juridico.db

DOCUMENT_MAX_SIZE_BYTES=52428800
DOCUMENT_UPLOAD_CHUNK_SIZE_BYTES=1048576
LEGAL_CHUNK_TARGET_CHARS=1800
LEGAL_CHUNK_MAX_CHARS=2400
LEGAL_CHUNK_OVERLAP_CHARS=200
PDF_MIN_EXTRACTABLE_CHARS=20

LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_THREADS=0
LOCAL_LLM_GPU_LAYERS=0
LOCAL_LLM_VERBOSE=false

EMBEDDING_MODEL_PATH=models/embeddings/multilingual-e5-small
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=query:
EMBEDDING_PASSAGE_PREFIX=passage:
TEXT_SEARCH_QUERY_MAX_CHARS=500
TEXT_SEARCH_MAX_TERMS=32
TEXT_SEARCH_DEFAULT_PAGE_SIZE=20
TEXT_SEARCH_MAX_PAGE_SIZE=100
TEXT_SEARCH_MAX_DOCUMENT_TYPES=10
CHROMA_PERSIST_PATH=storage/vector/chroma
SEMANTIC_INDEX_STATE_FILE=storage/vector/semantic_index_state.json
SEMANTIC_COLLECTION_PREFIX=legal_chunks
SEMANTIC_INDEX_SCHEMA_VERSION=2
SEMANTIC_INDEX_BATCH_SIZE=32
SEMANTIC_SEARCH_TOP_K_DEFAULT=10
SEMANTIC_SEARCH_TOP_K_MAX=50
SEMANTIC_SEARCH_CANDIDATE_MULTIPLIER=3
SEMANTIC_SNIPPET_MAX_LENGTH=500
SEMANTIC_QUERY_MAX_CHARS=1000
SEMANTIC_MAX_DOCUMENT_TYPES=10
HYBRID_RRF_K=60
HYBRID_TEXT_WEIGHT=1.0
HYBRID_SEMANTIC_WEIGHT=1.0
HYBRID_TOP_K_DEFAULT=10
HYBRID_TOP_K_MAX=50
HYBRID_CANDIDATE_MULTIPLIER=3
RAG_TOP_K_DEFAULT=8
RAG_TOP_K_MAX=20
RAG_CONTEXT_MAX_CHUNKS=8
RAG_CONTEXT_MAX_TOKENS=2200
RAG_MAX_NEW_TOKENS=512
RAG_TOKEN_SAFETY_MARGIN=128
RAG_QUESTION_MAX_LENGTH=2000
RAG_ANSWER_MAX_LENGTH=6000
RAG_TEMPERATURE=0.1
RAG_TOP_P=0.9
RAG_REPEAT_PENALTY=1.05
RAG_CITATION_MAX_SOURCES=8
RAG_SOURCE_NAME_MAX_LENGTH=255
HPN_MATRIX_TITLE_MAX_LENGTH=200
HPN_MATRIX_DESCRIPTION_MAX_LENGTH=4000
HPN_NODE_TITLE_MAX_LENGTH=200
HPN_NODE_STATEMENT_MAX_LENGTH=8000
HPN_RELATION_RATIONALE_MAX_LENGTH=4000
HPN_MAX_NODES_PER_MATRIX=500
HPN_MAX_RELATIONS_PER_MATRIX=2000
HPN_MAX_SOURCES_PER_NODE=20
HPN_SOURCE_NAME_MAX_LENGTH=255
GRAPH_MAX_NODES=300
GRAPH_MAX_EDGES=1000
GRAPH_MAX_LABEL_LENGTH=80
GRAPH_MAX_COMPONENTS_DETAIL=100
GRAPH_MAX_HTML_BYTES=5242880
GRAPH_MAX_TOOLTIP_LENGTH=240
GRAPH_RENDER_CONCURRENCY=1
