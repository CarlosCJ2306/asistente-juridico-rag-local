APP_NAME=Asistente Jurídico RAG Local
APP_ENV=development
DEBUG=true

API_PREFIX=/api
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=DEBUG
LOG_TO_FILE=true
LOG_CONSOLE=true
LOG_DIR=storage/logs
LOG_FILE_NAME=asistente_juridico_backend.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

DATABASE_FILE=storage/database/asistente_juridico.db

DOCUMENT_MAX_SIZE_BYTES=52428800
DOCUMENT_UPLOAD_CHUNK_SIZE_BYTES=1048576

LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_THREADS=0
LOCAL_LLM_GPU_LAYERS=0
LOCAL_LLM_VERBOSE=false

VITE_API_BASE_URL=http://localhost:8000
